# Copy this file to .env and adjust values if needed before running
# `docker compose up --build`. .env is gitignored — never commit real credentials.

# Postgres
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=changeme
POSTGRES_DB=urlshortener
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
